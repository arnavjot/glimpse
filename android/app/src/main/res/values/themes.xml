<?xml version="1.0" encoding="utf-8"?>
<!--
    Glimpse themes, built from the design system tokens (colors.xml, type.xml,
    dimens.xml). Material 3 colour roles are mapped once here; layouts use
    ?attr/color* and ?attr/textAppearance* so they follow light and dark.
-->
<resources>

    <!-- Shared by every theme: type and shape. -->
    <!-- NoActionBar: screens put a MaterialToolbar in their layout (edge-to-edge safe). -->
    <style name="Base.Theme.Glimpse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Glimpse.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Glimpse.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Glimpse.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Glimpse.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Glimpse.LabelLarge</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Glimpse.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Glimpse.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Glimpse.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Glimpse.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Glimpse.Large</item>

        <item name="materialCardViewStyle">@style/Widget.Glimpse.Card</item>
    </style>

    <!-- App theme: Settings and Performance. Follows the system light/dark setting. -->
    <style name="Theme.Glimpse" parent="Base.Theme.Glimpse">
        <item name="colorPrimary">@color/pn_brand</item>
        <item name="colorOnPrimary">@color/pn_on_brand</item>
        <item name="colorPrimaryContainer">@color/pn_surface_2</item>
        <item name="colorOnPrimaryContainer">@color/pn_ink</item>
        <item name="colorSecondary">@color/pn_brand</item>
        <item name="colorOnSecondary">@color/pn_on_brand</item>
        <item name="colorSecondaryContainer">@color/pn_surface_2</item>
        <item name="colorOnSecondaryContainer">@color/pn_ink</item>
        <item name="colorTertiary">@color/pn_like</item>
        <item name="colorError">@color/pn_error</item>
        <item name="colorOnError">@color/pn_on_brand</item>

        <item name="android:colorBackground">@color/pn_bg</item>
        <item name="colorOnBackground">@color/pn_ink</item>
        <item name="colorSurface">@color/pn_bg</item>
        <item name="colorOnSurface">@color/pn_ink</item>
        <item name="colorSurfaceVariant">@color/pn_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/pn_ink_muted</item>
        <item name="colorSurfaceContainerLowest">@color/pn_bg</item>
        <item name="colorSurfaceContainerLow">@color/pn_surface_1</item>
        <item name="colorSurfaceContainer">@color/pn_surface_1</item>
        <item name="colorSurfaceContainerHigh">@color/pn_surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/pn_surface_2</item>
        <item name="colorOutline">@color/pn_outline</item>
        <item name="colorOutlineVariant">@color/pn_outline</item>
    </style>

    <!--
        The feed: always dark, edge to edge, like any video player. Uses the raw dark
        palette directly so it stays dark even when the system is in light mode.
    -->
    <style name="Theme.Glimpse.Feed" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Same type and shape as Base.Theme.Glimpse (a theme can't have two parents). -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Glimpse.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Glimpse.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Glimpse.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Glimpse.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Glimpse.LabelLarge</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Glimpse.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Glimpse.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Glimpse.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Glimpse.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Glimpse.Large</item>

        <item name="materialCardViewStyle">@style/Widget.Glimpse.Card</item>
        <item name="android:windowBackground">@color/pn_dark_bg</item>

        <item name="colorPrimary">@color/pn_dark_brand</item>
        <item name="colorOnPrimary">@color/pn_dark_on_brand</item>
        <item name="colorSecondary">@color/pn_dark_brand</item>
        <item name="colorOnSecondary">@color/pn_dark_on_brand</item>
        <item name="colorTertiary">@color/pn_dark_like</item>
        <item name="colorError">@color/pn_dark_error</item>
        <item name="colorOnError">@color/pn_dark_on_brand</item>

        <item name="android:colorBackground">@color/pn_dark_bg</item>
        <item name="colorOnBackground">@color/pn_dark_ink</item>
        <item name="colorSurface">@color/pn_dark_bg</item>
        <item name="colorOnSurface">@color/pn_dark_ink</item>
        <item name="colorSurfaceVariant">@color/pn_dark_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/pn_dark_ink_muted</item>
        <item name="colorSurfaceContainer">@color/pn_dark_surface_1</item>
        <item name="colorSurfaceContainerHigh">@color/pn_dark_surface_2</item>
        <item name="colorOutline">@color/pn_dark_outline</item>
        <item name="colorOutlineVariant">@color/pn_dark_outline</item>
        <!-- The pull-to-refresh spinner. -->
        <item name="colorAccent">@color/pn_dark_brand</item>
    </style>

    <!-- Shapes: radius tokens. Buttons and chips are pills via Material 3's full corner. -->
    <style name="ShapeAppearance.Glimpse.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/pn_radius_sm</item>
    </style>

    <style name="ShapeAppearance.Glimpse.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/pn_radius_md</item>
    </style>

    <style name="ShapeAppearance.Glimpse.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/pn_radius_lg</item>
    </style>

    <!-- Cards: borders, not shadows. -->
    <style name="Widget.Glimpse.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
