<?xml version="1.0" encoding="utf-8"?>
<!--
    The feed. Draws edge to edge: top_bar gets the status bar inset and feed_overlay
    gets the navigation bar inset, both in code.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pn_dark_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Fixed over the pager: the caption scrim and the overlay don't slide with the clips. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Shown while the viewer has paused the clip by tapping it. -->
    <ImageView
        android:id="@+id/paused_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_paused"
        android:contentDescription="@string/paused"
        android:padding="@dimen/pn_space_4"
        android:src="@drawable/ic_play_arrow"
        android:visibility="gone"
        app:tint="@color/pn_feed_ink" />

    <!-- Playback progress, fixed at the bottom above the navigation bar (inset in code). -->
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:max="1000"
            app:indicatorColor="@color/pn_feed_ink"
            app:trackColor="@color/pn_progress_track"
            app:trackCornerRadius="0dp"
            app:trackThickness="2dp" />
    </FrameLayout>

    <include
        android:id="@+id/feed_overlay"
        layout="@layout/view_feed_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Empty and error state: icon, title, one line of help, one action. -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pn_space_8"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cloud_off"
            app:tint="@color/pn_dark_ink_muted" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_4"
            android:gravity="center"
            android:text="@string/feed_empty_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/pn_dark_ink" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_2"
            android:gravity="center"
            android:text="@string/feed_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/pn_dark_ink_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_6"
            android:minHeight="@dimen/pn_touch_target"
            android:text="@string/retry" />
    </LinearLayout>

    <!-- Over the video: debug overlay and actions, then the offline pill under them. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/pn_space_4"
        android:paddingTop="@dimen/pn_space_2"
        android:paddingEnd="@dimen/pn_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Post a clip: hidden while the remote "uploads" flag is off. -->
            <ImageButton
                android:id="@+id/post_clip"
                android:layout_width="@dimen/pn_touch_target"
                android:layout_height="@dimen/pn_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/post_clip"
                android:src="@drawable/ic_add"
                app:tint="@color/pn_feed_ink" />

            <ImageButton
                android:id="@+id/open_performance"
                android:layout_width="@dimen/pn_touch_target"
                android:layout_height="@dimen/pn_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/performance"
                android:src="@drawable/ic_speed"
                app:tint="@color/pn_feed_ink" />

            <ImageButton
                android:id="@+id/open_settings"
                android:layout_width="@dimen/pn_touch_target"
                android:layout_height="@dimen/pn_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/pn_feed_ink" />
        </LinearLayout>

        <!--
            Start-time overlay (debug, from Settings): its own line under the buttons, so
            it has the full width and can never cover Performance or Settings.
        -->
        <TextView
            android:id="@+id/overlay"
            style="@style/Widget.Glimpse.FeedChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_1"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Glimpse.Mono"
            android:visibility="gone"
            tools:text="first frame 188 ms · preload off"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/offline_banner"
            style="@style/Widget.Glimpse.FeedChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/pn_space_2"
            android:accessibilityLiveRegion="polite"
            android:text="@string/offline_banner"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_cloud_off"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
