<?xml version="1.0" encoding="utf-8"?>
<!-- One upload: title, status (with progress while sending), and the error if it failed. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/pn_space_4"
    android:layout_marginVertical="@dimen/pn_space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/pn_touch_target"
        android:orientation="vertical"
        android:padding="@dimen/pn_space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="My sunset upload" />

            <!-- Delete (or Cancel while still sending). -->
            <ImageButton
                android:id="@+id/delete"
                android:layout_width="@dimen/pn_touch_target"
                android:layout_height="@dimen/pn_touch_target"
                android:layout_marginStart="@dimen/pn_space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/upload_delete"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Processing" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_2"
            android:max="100"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="That file has no video."
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
