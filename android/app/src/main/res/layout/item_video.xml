<?xml version="1.0" encoding="utf-8"?>
<!--
    One full-screen feed page: just the poster (shown until the first frame) and the
    shared player's surface. Tapping it pauses or continues the clip. Captions and the like rail live in the feed's fixed overlay
    (view_feed_overlay.xml), so they don't slide with the page.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pn_dark_bg"
    android:contentDescription="@string/play_pause">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:use_controller="false" />
</FrameLayout>
